# ডিপ্লয়ের পর নিরাপদ করতে নিচের connect-src-এ "https: wss:" বদলে নিজের API হোস্ট দিন:
# connect-src 'self' https://securechat-api.YOUR-NAME.workers.dev wss://securechat-api.YOUR-NAME.workers.dev
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src 'self' https: wss:; frame-src https://www.youtube-nocookie.com; manifest-src 'self'; media-src 'self' blob:; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
/sw.js
  Cache-Control: no-cache
